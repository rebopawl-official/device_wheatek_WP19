/data                     f2fs     /dev/block/platform/bootdevice/by-name/userdata          flags=display=data;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized;keydirectory=/metadata/vold/metadata_encryption;fsverity
/cache                    ext4     /dev/block/platform/bootdevice/by-name/cache             flags=display=cache
